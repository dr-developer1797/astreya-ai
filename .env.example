# Required for LLM generation (/api/chat)
GEMINI_API_KEY=

# Optional: Indian Kanoon case-law retrieval (/api/legal-search)
INDIAN_KANOON_API_KEY=

# Optional: require Bearer or x-astreya-key on /api/* routes in production
ASTREYA_API_KEY=

# Convex (run `npx convex dev` — copies NEXT_PUBLIC_CONVEX_URL into .env.local)
NEXT_PUBLIC_CONVEX_URL=
